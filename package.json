{
  "name": "vite-plugin-glob-input",
  "version": "0.3.1",
  "description": "Vite plugin to add files to build.rollupOptions.input using fast-glob",
  "author": "ozekimasaki",
  "license": "MIT",
  "homepage": "https://github.com/ozekimasaki/vite-plugin-glob-input#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozekimasaki/vite-plugin-glob-input.git"
  },
  "bugs": {
    "url": "https://github.com/ozekimasaki/vite-plugin-glob-input/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "static",
    "glob"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "type-check": "tsc --noEmit -p .",
    "test:vite6": "cross-env VITE_MAJOR_VERSION=6 vitest run",
    "test:vite7": "cross-env VITE_MAJOR_VERSION=7 vitest run",
    "test:vite8": "cross-env VITE_MAJOR_VERSION=8 vitest run",
    "test": "pnpm test:vite6 && pnpm test:vite7 && pnpm test:vite8",
    "test:watch": "vitest",
    "coverage": "cross-env VITE_MAJOR_VERSION=8 vitest run --coverage",
    "tsc": "tsc -p .",
    "build": "pnpm clean && pnpm tsc",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "fs-extra": "^11.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite6": "npm:vite@^6.4.3",
    "vite7": "npm:vite@^7.3.6",
    "vitest": "^4.1.10"
  }
}
